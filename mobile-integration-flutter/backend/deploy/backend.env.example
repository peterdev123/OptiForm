# Bind
HOST=0.0.0.0
PORT=8000

# Model configuration
SQUAT_QWEN_BASE_MODEL=unsloth/qwen2.5-3b-instruct-unsloth-bnb-4bit
SQUAT_MISTRAL_BASE_MODEL=mistralai/Mistral-7B-Instruct-v0.3
SQUAT_MISTRAL_LORA_PATH=Fine-Tuning/mistral-7b-squat-lora-main
SQUAT_DEFAULT_MODEL_VARIANT=model_1
SQUAT_FINETUNED_MODEL_PATH=Fine-Tuning/qwen2p5-3b-squat-lora/qwen2p5-3b-squat-lora/checkpoint-450

# Security / CORS
ALLOWED_ORIGINS=https://your-app-domain.example
RATE_LIMIT_PER_MINUTE=30
RATE_LIMIT_WINDOW_SECONDS=60

