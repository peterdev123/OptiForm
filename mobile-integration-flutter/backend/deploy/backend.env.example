# Bind
HOST=0.0.0.0
PORT=8000

# Model configuration (Qwen only)
SQUAT_QWEN_BASE_MODEL=unsloth/qwen2.5-3b-instruct-unsloth-bnb-4bit
SQUAT_DEFAULT_MODEL_VARIANT=finetuned
SQUAT_FINETUNED_MODEL_PATH=Fine-Tuning/qwen2p5-3b-squat-lora/qwen2p5-3b-squat-lora/checkpoint-450

# Warmup: load weights when the process starts (not on first API call).
# Set MODEL_WARMUP_BLOCKING=true to block accepting traffic until load completes.
# Set SKIP_MODEL_WARMUP=true to skip (first request will load the model).
MODEL_WARMUP_BLOCKING=false
SKIP_MODEL_WARMUP=false

# Security / CORS
ALLOWED_ORIGINS=https://your-app-domain.example
RATE_LIMIT_PER_MINUTE=30
RATE_LIMIT_WINDOW_SECONDS=60
